<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.piotrszybicki.independentintelijaiplugin</id>
    <name>AICodingAgent</name>
    <vendor>piotr-szybicki</vendor>
    <description><![CDATA[
        <p><b>AICodingAgent</b> is a simple chat tool window backed by the Anthropic Messages API, or by any provider speaking OpenAI's Chat Completions or Responses API &mdash; OpenAI, Azure, Microsoft Foundry, OpenRouter, or a local vLLM or Ollama server.</p>
        <p>Set the <code>AI_API_KEY</code> environment variable to your API key and restart the IDE, then chat from the tool window. Model, endpoint, API protocol and MCP servers are configured under Settings | Tools | AICodingAgent, and <code>AI_API_URL</code> points a run at a different endpoint without editing them.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <!-- The git_* tools. Bundled and enabled by default in every IDE, so a hard dependency rather
         than an optional descriptor, which the tool catalog's flat list has no shape for. -->
    <depends>Git4Idea</depends>
    <!-- SMTestProxy and friends moved out of the core platform into this bundled plugin in 2026.2. -->
    <depends>intellij.testRunner.plugin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.piotrszybicki.independentintelijaiplugin.toolWindow.ChatToolWindowFactory" id="AICodingAgent"
                    anchor="right" icon="/icons/chatToolWindow.svg"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.github.piotrszybicki.independentintelijaiplugin.settings.AICodingAgentSettingsConfigurable"
            id="com.github.piotrszybicki.independentintelijaiplugin.settings.AICodingAgentSettingsConfigurable"
            displayName="AICodingAgent"/>
    </extensions>

    <actions>
        <action id="AICodingAgent.OpenSideChat"
                class="com.github.piotrszybicki.independentintelijaiplugin.toolWindow.ChatAboutSelectionAction"
                text="Open a Side Chat"
                description="Start a new AI chat about the selected code"
                icon="/icons/chatAboutCode.svg">
            <add-to-group group-id="Floating.CodeToolbar" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
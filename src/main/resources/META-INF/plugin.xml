<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.piotrszybicki.independentintelijaiplugin</id>
    <name>AICodingAgent</name>
    <vendor>piotr-szybicki</vendor>
    <description><![CDATA[
        <p><b>AICodingAgent</b> is a simple chat tool window backed by the Anthropic Messages API, or by any provider speaking OpenAI's Chat Completions or Responses API &mdash; OpenAI, Azure, Microsoft Foundry, OpenRouter, or a local vLLM or Ollama server.</p>
        <p>Set the <code>AI_API_KEY</code> environment variable to your API key and restart the IDE, then chat from the tool window. Providers live in <code>independent-ai-plugin-settings.json</code> in the project root, or wherever <code>INTELIJ_AI_SETTINGS</code> points &mdash; one entry per model or provider, with the token read from an environment variable when it starts with <code>$</code> &mdash; and the entry in force is picked from a dropdown under Settings | Tools | AICodingAgent, where the token budget, tools, MCP servers and skills are configured too.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <!-- The git_* tools. Bundled and enabled by default in every IDE, so a hard dependency rather
         than an optional descriptor, which the tool catalog's flat list has no shape for. -->
    <depends>Git4Idea</depends>
    <!-- SMTestProxy and friends moved out of the core platform into this bundled plugin in 2026.2. -->
    <depends>intellij.testRunner.plugin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.piotrszybicki.independentintelijaiplugin.toolWindow.ChatToolWindowFactory" id="AICodingAgent"
                    anchor="right" icon="/icons/chatToolWindow.svg"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.github.piotrszybicki.independentintelijaiplugin.settings.AICodingAgentSettingsConfigurable"
            id="com.github.piotrszybicki.independentintelijaiplugin.settings.AICodingAgentSettingsConfigurable"
            displayName="AICodingAgent"/>
        <!-- Writes independent-ai-plugin-settings.json into the project root when it is missing, and
             reports the one state the plugin will not run in: INTELIJ_AI_SETTINGS naming a file that
             is not there. -->
        <postStartupActivity
            implementation="com.github.piotrszybicki.independentintelijaiplugin.settings.AgentConfigurationStartup"/>
        <!-- Releases the chat restore that a tool window rebuilt during frame init holds back, so a
             restart resumes the conversation. -->
        <postStartupActivity
            implementation="com.github.piotrszybicki.independentintelijaiplugin.toolWindow.ChatRestoreActivity"/>
        <!-- Sticky: the only thing reported through it is why the tool window will not open. -->
        <notificationGroup id="AICodingAgent" displayType="STICKY_BALLOON"/>
        <!-- Where a reply was exported to. Its own group so it can fade: the user has just been
             through a save dialog and knows it happened, so the balloon is only there for the path
             and the link that opens it. -->
        <notificationGroup id="AICodingAgent.Export" displayType="BALLOON"/>
        <!-- What a Javadoc sweep did. Fades: it is a summary of a change the user just asked for and
             can see in the editor, not something that needs dismissing. -->
        <notificationGroup id="AICodingAgent.Cleanup" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="AICodingAgent.OpenSideChat"
                class="com.github.piotrszybicki.independentintelijaiplugin.toolWindow.ChatAboutSelectionAction"
                text="Open a Side Chat"
                description="Start a new AI chat about the selected code"
                icon="/icons/chatAboutCode.svg">
            <add-to-group group-id="Floating.CodeToolbar" anchor="last"/>
        </action>
        <!-- Under Tools, and in the project view's context menu so the selection there can scope it. -->
        <action id="AICodingAgent.RemoveJavadoc"
                class="com.github.piotrszybicki.independentintelijaiplugin.cleanup.RemoveJavadocAction"
                text="Remove Javadoc Comments..."
                description="Strip Javadoc-form comments from the project, or from the selected files">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AICodingAgent.MoveCommentsToDatabase"
                class="com.github.piotrszybicki.independentintelijaiplugin.cleanup.MoveCommentsToDatabaseAction"
                text="Move Javadoc Comments to Database..."
                description="Store Javadoc-form comments in the database and leave a comment_id marker in their place">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AICodingAgent.RestoreComments"
                class="com.github.piotrszybicki.independentintelijaiplugin.cleanup.RestoreCommentsAction"
                text="Restore Comments From Database..."
                description="Replace every comment_id marker with the comment stored under that id">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>